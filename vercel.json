{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "flask_app/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "flask_app/templates/**",
          "flask_app/static/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "flask_app/app.py"
    }
  ]
}
